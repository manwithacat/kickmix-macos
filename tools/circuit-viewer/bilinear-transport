set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
python_bin="$here/../../.venv/bin/python"
if [[ ! -x "$python_bin" ]]; then
  echo "bilinear-transport: expected $python_bin; set up the kickmix-macos venv" >&2
  exit 2
fi
exec "$python_bin" "$here/bilinear_transport.py" "$@"

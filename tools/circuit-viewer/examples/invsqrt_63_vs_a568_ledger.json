 "definitions": {
  "account": "a wire; register wires grouped by register (numbered families folded: S0..S69 -> S*)",
  "entry": "an op touching the account: toffoli (CCX/CSWAP target), data (CX/X/SWAP target), phase (Z/CZ/CCZ/Z_POW), control, settle (R/HMR)",
  "value": "one lifetime of a non-register wire (the width verb's interval): opened at its first touch after a reset, closed at an unconditional R/HMR or at its last touch",
  "contra": "value closed at its last touch: erased by unitary uncompute (presumed statically; checked exactly for invsqrt)",
  "accrual": "value closed by HMR whose record later conditions fix-ups: a phase liability until the last one",
  "dead-tail": "value closed by R, or by HMR whose record nothing reads",
  "liability": "one HMR record, open from the HMR to the last op it (or a bit derived from it) conditions",
  "trial balance": "at each stage cut: values open across the cut, liabilities open across it, live width",
  "capital": "qubit-ops \u00d7 rate / ops: T-eq of width used; charged = certified width \u00d7 rate",
  "paying twice": "a CCX computing the same AND as an earlier one (exact: equal on every x; static: same wire versions)"
 }

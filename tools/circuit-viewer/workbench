set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
python_bin="$here/../../.venv/bin/python"
if [[ ! -x "$python_bin" ]]; then
  echo "workbench: run setup for kickmix-macos; expected $python_bin" >&2
  exit 2
fi
exec "$python_bin" "$here/workbench.py" "$@"

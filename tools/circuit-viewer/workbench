#!/usr/bin/env bash
# Copyright 2026 James Barlow
# SPDX-License-Identifier: Apache-2.0
# Runs workbench.py with the fork's .venv (NumPy). WORKBENCH_PYTHON overrides
# the interpreter, e.g. for a git worktree that shares another checkout's venv.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
python_bin="${WORKBENCH_PYTHON:-$here/../../.venv/bin/python}"
if [[ ! -x "$python_bin" ]]; then
  printf '{"error": "no Python interpreter at %s", "hint": "set up the kickmix-macos .venv or set WORKBENCH_PYTHON"}\n' "$python_bin"
  exit 2
fi
exec "$python_bin" "$here/workbench.py" "$@"
